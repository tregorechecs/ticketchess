            <script>
              (function () {
                var simuled = document.getElementById('stripe.simuled');
                var publicKey = document.getElementById('stripe.public');
                var secretKey = document.getElementById('stripe.secret');
                var prefix = document.getElementById('stripe.keyprefix');
                var cardEvents = document.getElementById('stripe.card.events');
                var cardMemberships = document.getElementById('stripe.card.memberships');
                var keyFields = [
                  { input: publicKey, label: document.getElementById('stripe-public-label') },
                  { input: secretKey, label: document.getElementById('stripe-secret-label') },
                  { input: prefix, label: document.getElementById('stripe-prefix-label') }
                ];
                var cardFields = [
                  { input: cardEvents, label: document.getElementById('stripe-card-events-label') },
                  { input: cardMemberships, label: document.getElementById('stripe-card-memberships-label') }
                ];
                function setDisabled(fields, disabled) {
                  fields.forEach(function (field) {
                    if (!field.input) return;
                    field.input.disabled = disabled;
                    if (field.label) {
                      field.label.classList.toggle('text-body-secondary', disabled);
                    }
                  });
                }
                function syncStripeForm() {
                  if (!simuled) return;
                  var simulate = simuled.checked;
                  setDisabled(keyFields, simulate);
                  var publicBlank = !publicKey || !publicKey.value.trim();
                  setDisabled(cardFields, !simulate && publicBlank);
                }
                if (simuled) simuled.addEventListener('change', syncStripeForm);
                if (publicKey) publicKey.addEventListener('input', syncStripeForm);
                syncStripeForm();
              })();
            </script>
