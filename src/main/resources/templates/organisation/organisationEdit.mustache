    {{#editMode}}
    <script type="text/javascript">
      async function handleOrgFileResponse(res, statusEl, button, errorMessage) {
        const contentType = res.headers.get('Content-Type') || '';
        if (contentType.includes('application/json')) {
          const data = await res.json();
          if (data.redirect) {
            window.location.assign(data.redirect);
            return;
          }
        }
        if (!res.ok) {
          const text = await res.text();
          statusEl.className = 'alert mb-3 alert-danger';
          statusEl.textContent = text || errorMessage;
          statusEl.classList.remove('d-none');
          button.disabled = false;
        }
      }
      function bindUpload(formId, inputId, buttonId, url, contentType) {
        const form = document.getElementById(formId);
        if (!form) return;
        const fileInput = document.getElementById(inputId);
        const button = document.getElementById(buttonId);
        const statusEl = document.getElementById('rib-status');
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const file = fileInput.files[0];
          if (!file) {
            return;
          }
          button.disabled = true;
          try {
            const res = await fetch(url, {
              method: 'POST',
              headers: { 'Content-Type': contentType, 'Accept': 'application/json' },
              body: file
            });
            await handleOrgFileResponse(res, statusEl, button, '{{#i18n}}admin.uploadFailed{{/i18n}}');
          } catch (e) {
            statusEl.className = 'alert mb-3 alert-danger';
            statusEl.textContent = '{{#i18n}}admin.uploadFailed{{/i18n}}';
            statusEl.classList.remove('d-none');
            button.disabled = false;
          }
        });
      }
      function bindDelete(buttonId, url, confirmMessage) {
        const button = document.getElementById(buttonId);
        if (!button) return;
        const statusEl = document.getElementById('rib-status');
        button.addEventListener('click', async () => {
          if (!window.confirm(confirmMessage)) {
            return;
          }
          button.disabled = true;
          try {
            const res = await fetch(url, {
              method: 'DELETE',
              headers: { 'Accept': 'application/json' }
            });
            await handleOrgFileResponse(res, statusEl, button, '{{#i18n}}admin.deleteFailed{{/i18n}}');
          } catch (e) {
            statusEl.className = 'alert mb-3 alert-danger';
            statusEl.textContent = '{{#i18n}}admin.deleteFailed{{/i18n}}';
            statusEl.classList.remove('d-none');
            button.disabled = false;
          }
        });
      }
      const orgBase = '{{contextPath}}/admin/organisations/{{organisation.id}}';
      bindUpload('rib-upload-form', 'rib-file', 'rib-upload-btn', orgBase + '/rib', 'application/octet-stream');
      bindUpload('logo-upload-form', 'logo-file', 'logo-upload-btn', orgBase + '/logo', 'application/octet-stream');
      bindUpload('signature-upload-form', 'signature-file', 'signature-upload-btn', orgBase + '/signature', 'application/octet-stream');
      bindUpload('background-upload-form', 'background-file', 'background-upload-btn', orgBase + '/background', 'application/octet-stream');
      bindDelete('logo-delete-btn', orgBase + '/logo', '{{#i18n}}action.confirm{{/i18n}}');
      bindDelete('signature-delete-btn', orgBase + '/signature', '{{#i18n}}action.confirm{{/i18n}}');
      bindDelete('background-delete-btn', orgBase + '/background', '{{#i18n}}action.confirm{{/i18n}}');
      bindDelete('rib-delete-btn', orgBase + '/rib', '{{#i18n}}action.confirm{{/i18n}}');

      const hash = (window.location.hash || '').replace('#', '');
      if (hash) {
        const trigger = document.querySelector('[data-bs-target="#' + hash + '"]');
        if (trigger && window.bootstrap) {
          window.bootstrap.Tab.getOrCreateInstance(trigger).show();
        }
      }
      document.querySelectorAll('#org-tabs button[data-bs-toggle="tab"]').forEach((btn) => {
        btn.addEventListener('shown.bs.tab', (event) => {
          const target = event.target.getAttribute('data-bs-target');
          if (target) {
            history.replaceState(null, '', target);
          }
        });
      });
    </script>
    {{/editMode}}
  </body>
</html>
