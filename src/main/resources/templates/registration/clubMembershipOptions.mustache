{{> platform/head}}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">

<html>

<body class="d-flex flex-column min-vh-100 bg-chess-overlay">
  {{> platform/menubar}}

  <main class="container flex-fill mt-3">
    <nav aria-label="breadcrumb" class="mb-3 mt-3">
      <ol class="breadcrumb bg-body rounded px-3 py-2 mb-0">
        <li class="breadcrumb-item"><a href="{{contextPath}}/">{{#i18n}}breadcrumb.home{{/i18n}}</a></li>
        <li class="breadcrumb-item"><a href="{{contextPath}}/club-register?query=">{{#i18n}}page.clubRegister{{/i18n}}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{#i18n}}clubRegister.membershipOptions.title{{/i18n}}</li>
      </ol>
    </nav>

    <div class="bg-body p-3 rounded mb-3">
      <h1 class="h3 mb-2">{{#i18n}}clubRegister.membershipOptions.title{{/i18n}}</h1>
      <p class="mb-0 text-body-secondary">
        {{playerSummaryLine}}
      </p>
    </div>

    {{#errorIsLicenseRequired}}
      <div class="alert alert-danger" role="alert">{{#i18n}}clubRegister.membershipOptions.licenseRequired{{/i18n}}</div>
    {{/errorIsLicenseRequired}}

    <div class="bg-body p-3 rounded mb-3">
      <form method="POST" action="{{contextPath}}/club-register/membership-options">
        <input type="hidden" name="nrffe" value="{{nrffe}}">
        {{#manualPlayer}}
          <input type="hidden" name="lastname" value="{{lastname}}">
          <input type="hidden" name="firstname" value="{{firstname}}">
          <input type="hidden" name="birthdate" value="{{birthdate}}">
        {{/manualPlayer}}

        <div class="list-group mb-3">
          <div class="list-group-item active">{{#i18n}}clubRegister.membershipOptions.licenseTitle{{/i18n}}</div>
          {{#licenses}}
          <label class="list-group-item d-flex justify-content-between align-items-center" data-license-id="{{id}}">
            <span>
              {{#selected}}
              <input class="form-check-input me-2 js-license" type="radio" name="licenseType" value="{{name}}" data-price-cents="{{priceCents}}" data-license-id="{{id}}" checked required>
              {{/selected}}{{^selected}}
              <input class="form-check-input me-2 js-license" type="radio" name="licenseType" value="{{name}}" data-price-cents="{{priceCents}}" data-license-id="{{id}}" required>
              {{/selected}}
              {{#i18n}}{{licenseMessageKey}}{{/i18n}}
            </span>
            <span class="text-body-secondary">{{priceDisplay}} €</span>
          </label>
          {{/licenses}}
        </div>

        {{#hasOptions}}
          <div class="mb-2 fw-semibold">{{#i18n}}clubRegister.membershipOptions.optionsTitle{{/i18n}}</div>
          <div class="list-group mb-3" id="options-container">
            {{#options}}
              
                <label class="list-group-item d-flex justify-content-between align-items-center" data-license-id="{{licenseId}}" data-option-id="{{id}}" data-option-type="{{optionType}}">
                  <span>
                    <input class="form-check-input me-2 js-option" type="checkbox" name="optionIds" value="{{id}}" data-price-cents="{{amountCents}}" data-option-type="{{optionType}}">
                    <strong>{{#i18n}}{{optionTypeMessageKey}}{{/i18n}}</strong> - {{optionValue}}
                  </span>
                  <span class="text-body-secondary">{{priceDisplay}} €</span>
                </label>
              
            {{/options}}
          </div>
        {{/hasOptions}}{{^hasOptions}}
          <p class="mb-3">{{#i18n}}clubRegister.membershipOptions.none{{/i18n}}</p>
        {{/hasOptions}}

        <div class="alert alert-info d-flex justify-content-between align-items-center" role="status">
          <span class="fw-semibold">{{#i18n}}clubRegister.membershipOptions.total{{/i18n}}</span>
          <span id="membership-total">0.00 €</span>
        </div>
        <button type="submit" class="btn btn-primary">{{#i18n}}action.save{{/i18n}}</button>
      </form>
    </div>
  </main>

  <script>
    (function () {
      const totalElement = document.getElementById('membership-total');
      if (!totalElement) {
        return;
      }

      const licenseInputs = Array.from(document.querySelectorAll('.js-license'));
      const optionInputs = Array.from(document.querySelectorAll('.js-option'));
      const optionsContainer = document.getElementById('options-container');

      const readPrice = function (input) {
        const raw = input.getAttribute('data-price-cents') || '0';
        const normalized = raw.toString().replace(/[^0-9.-]/g, '');
        const parsed = Number(normalized);
        return Number.isFinite(parsed) ? parsed : 0;
      };

      const formatter = new Intl.NumberFormat(document.documentElement.lang || navigator.language, {
        style: 'currency',
        currency: 'EUR'
      });

      const updateOptionVisibility = function () {
        if (!optionsContainer) {
          return;
        }
        const selectedLicense = licenseInputs.find(function (input) {
          return input.checked;
        });
        
        if (!selectedLicense) {
          return;
        }

        const selectedLicenseId = parseInt(selectedLicense.getAttribute('data-license-id') || '0', 10);

        // Update option disabled state
        const optionLabels = optionsContainer.querySelectorAll('label');
        optionLabels.forEach(function (label) {
          const optionLicenseId = parseInt(label.getAttribute('data-license-id') || '0', 10);
          const checkbox = label.querySelector('input[type="checkbox"]');
          
          // Option is enabled if:
          // - it applies to all licenses (optionLicenseId === 0) OR
          // - it matches the selected license (optionLicenseId === selectedLicenseId)
          const shouldEnable = optionLicenseId === 0 || optionLicenseId === selectedLicenseId;
          
          if (checkbox) {
            checkbox.disabled = !shouldEnable;
            
            // If option becomes disabled and is checked, uncheck it
            if (!shouldEnable && checkbox.checked) {
              checkbox.checked = false;
            }
          }
          
          // Add/remove visual disabled state
          if (!shouldEnable) {
            label.classList.add('opacity-75');
          } else {
            label.classList.remove('opacity-75');
          }
        });
      };

      const render = function () {
        let totalCents = 0;

        const selectedLicense = licenseInputs.find(function (input) {
          return input.checked;
        });
        if (selectedLicense) {
          totalCents += readPrice(selectedLicense);
        }

        optionInputs.forEach(function (input) {
          if (input.disabled && input.checked) {
            input.checked = false;
          }
          if (input.checked) {
            totalCents += readPrice(input);
          }
        });

        totalElement.textContent = formatter.format(totalCents / 100);
      };

      // Handle COURSES option exclusivity
      optionInputs.forEach(function (input) {
        input.addEventListener('change', function () {
          // If this is a COURSES checkbox and it's being checked
          if (this.checked && this.getAttribute('data-option-type') === 'COURSES') {
            // Uncheck all other COURSES checkboxes
            optionInputs.forEach(function (otherInput) {
              if (otherInput !== input && otherInput.getAttribute('data-option-type') === 'COURSES' && otherInput.checked) {
                otherInput.checked = false;
              }
            });
          }
          updateOptionVisibility();
          render();
        });
      });

      licenseInputs.forEach(function (input) {
        input.addEventListener('change', function () {
          updateOptionVisibility();
          render();
        });
      });

      updateOptionVisibility();
      render();
    })();
  </script>

  {{> platform/footer}}
</body>

</html>
