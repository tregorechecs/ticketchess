{{> platform/head}}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">

    <html>


    <body class="d-flex flex-column min-vh-100 bg-chess-overlay">
{{> platform/menubar}}
        <main class="container flex-fill mt-3">
          <div class="bg-body p-3 pb-1 rounded mb-3">
            <h2>{{#i18n}}action.register{{/i18n}} {{event.name}}</h2>
            {{#registrationClosed}}
              <div class="alert alert-warning" role="alert">{{#i18n}}{{registrationClosedMessageKey}}{{/i18n}}</div>
              <div class="alert alert-info" role="alert">{{#i18n}}event.pendingQueueAvailable{{/i18n}}</div>
            {{/registrationClosed}}
          <form method="GET" class="mb-3">
            <div class="mb-3">
              <label for="player" class="form-label">{{#i18n}}search.label{{/i18n}}</label>
              <input type="text" class="form-control" id="player" name="query"  value="{{query}}"/>
            </div>
            <div class="d-flex align-items-center">
                <button type="submit" id="searchplayer" class="btn btn-primary">
                  {{#i18n}}action.search{{/i18n}}
                </button>

                <a href="{{contextPath}}/customplayer/new?eventId={{event.id}}"
                   class="ms-3 btn btn-secondary"
                   id="createPlayer">
                   {{#i18n}}action.create{{/i18n}}
                </a>
              </div>
          </form>
          </div>
          {{#hasPlayers}}
          <div class="rounded mb-3 " style="overflow: hidden;"> 
          <table class="table table-striped mb-0">
            <thead>
              <tr>
                <th scope="col">{{#i18n}}player.licence{{/i18n}}</th>
                <th scope="col">{{#i18n}}player.name{{/i18n}}</th>
                <th scope="col" class="d-none d-md-table-cell">{{#i18n}}player.category{{/i18n}}</th>
                <th scope="col" class="d-none d-md-table-cell">{{#i18n}}player.rating{{/i18n}}</th>
                <th scope="col" class="d-none d-md-table-cell">{{#i18n}}player.club{{/i18n}}</th>
                {{#eventNotFree}}
                <th scope="col">{{#i18n}}event.price{{/i18n}}</th>
                {{/eventNotFree}}
                <th scope="col"></th>
              </tr>
            </thead>
            <tbody>
                {{#players}}
              <tr>
                <td>{{licenceOrEmpty}}</td>
                <td>{{name}} {{firstname}} {{#fideTitre}}<span class="badge bg-success">{{#i18n}}{{fideTitreMessageKey}}{{/i18n}}</span>{{/fideTitre}}</td>
                <td class="d-none d-md-table-cell">{{categoryOrEmpty}}</td>
                <td class="d-none d-md-table-cell">{{ratingOrEmpty}}</td>
                <td class="d-none d-md-table-cell">{{clubOrEmpty}}</td>
                {{#eventNotFree}}
                <td>{{price}}</td>
                {{/eventNotFree}}
                <td><form method="POST">
                  <input type="hidden" name="nrffe" value="{{licence}}"/>
                  <button type="submit" class="btn-sm btn btn-secondary js-select">&#10133; {{#i18n}}{{selectActionKey}}{{/i18n}}</button></form></td>
                </tr>
              {{/players}}
            </tbody>
          </table>
          </div>
          {{/hasPlayers}}
          {{#showNoPlayer}}
            <div class="bg-body p-3 pb-1 rounded mb-3">
          	<p><span>{{#i18n}}info.noplayer{{/i18n}}</span></p></div>
          {{/showNoPlayer}}
          {{#hasFavoritePlayers}}
          <div class="bg-body p-3 pb-1 rounded mb-3">
            <h3>{{#i18n}}search.favorites{{/i18n}}</h3>
            <div class="rounded mb-3 " style="overflow: hidden;"> 
            <table class="table table-striped mb-0">
            <thead>
              <tr>
                <th scope="col">{{#i18n}}player.licence{{/i18n}}</th>
                <th scope="col">{{#i18n}}player.name{{/i18n}}</th>
                <th scope="col" class="d-none d-md-table-cell">{{#i18n}}player.category{{/i18n}}</th>
                <th scope="col" class="d-none d-md-table-cell">{{#i18n}}player.rating{{/i18n}}</th>
                <th scope="col" class="d-none d-md-table-cell">{{#i18n}}player.club{{/i18n}}</th>
                {{#eventNotFree}}
                  <th scope="col">{{#i18n}}event.price{{/i18n}}</th>
                {{/eventNotFree}}
                <th scope="col"></th>
              </tr>
            </thead>
            <tbody>
                {{#favoritePlayers}}
              <tr>
                <td>{{licenceOrEmpty}}</td>
                <td>{{name}} {{firstname}}</td>
                <td class="d-none d-md-table-cell">{{category}}</td>
                <td class="d-none d-md-table-cell">{{rating}}</td>
                <td class="d-none d-md-table-cell">{{clubOrEmpty}}</td>
                {{#eventNotFree}}
                  <td>{{price}}</td>
                {{/eventNotFree}}
                <td><form method="POST">
                  <input type="hidden" name="id" value="{{event.id}}"/>
                  <input type="hidden" name="nrffe" value="{{nrffeId}}"/>
                  <button type="submit" class="btn-sm btn btn-secondary">&#10133; {{#i18n}}{{selectActionKey}}{{/i18n}}</button></form></td>
                </tr>
              {{/favoritePlayers}}
            </tbody>
          </table>
          </div>
          </div>
          {{/hasFavoritePlayers}}
        </main>
		{{> platform/footer}}
    </body>

    </html>
