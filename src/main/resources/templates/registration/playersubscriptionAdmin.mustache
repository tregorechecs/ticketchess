{{> platform/head}}
<html>
  <body class="d-flex flex-column min-vh-100 bg-chess-overlay">
    {{> platform/menubar}}
    <main class="container flex-fill mt-3">
      <nav aria-label="breadcrumb" class="admin-breadcrumb mb-3">
        <ol class="breadcrumb bg-body rounded px-3 py-2 mb-0">
          <li class="breadcrumb-item"><a href="{{contextPath}}/">{{#i18n}}breadcrumb.home{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/admin">{{#i18n}}menu.admin{{/i18n}}</a></li>

          <li class="breadcrumb-item active" aria-current="page">{{#i18n}}page.playerSubscriptionsAdmin{{/i18n}}</li>
        </ol>
      </nav>

    {{#showReplaceResult}}
      {{#replaceResultHasFailures}}
        <div class="alert alert-warning mb-4" role="alert">
          {{replaceResultText}}
        </div>
      {{/replaceResultHasFailures}}{{^replaceResultHasFailures}}
        <div class="alert alert-success mb-4" role="alert">
          {{replaceResultText}}
        </div>
      {{/replaceResultHasFailures}}
    {{/showReplaceResult}}
    {{#showDeleteResult}}
      {{#deleteResultHasFailures}}
        <div class="alert alert-warning mb-4" role="alert">
          {{deleteResultText}}
        </div>
      {{/deleteResultHasFailures}}{{^deleteResultHasFailures}}
        <div class="alert alert-success mb-4" role="alert">
          {{deleteResultText}}
        </div>
      {{/deleteResultHasFailures}}
    {{/showDeleteResult}}
  

    <div class="admin-table-panel mb-4">
        <div class="d-flex align-items-start gap-3">
          <i class="bi bi-person-check fs-2 text-primary"></i>
          <div>
            <h1 class="h3 mb-1">{{#i18n}}heading.playerSubscriptionsAdmin{{/i18n}}</h1>
          <p class="text-body-secondary mb-0">{{#i18n}}help.playerSubscriptionsAdmin{{/i18n}}</p>
          </div>
        </div>
      </div>

    <div class="admin-table-panel mb-4">
      <p class="text-body-secondary mb-3">{{playersSubCountsText}}</p>
      <div class="admin-toolbar d-flex flex-wrap align-items-center gap-2">
        <form method="get" action="{{contextPath}}/playersubscription-admin" class="d-flex align-items-center mb-0">
          <div class="input-group w-auto">
    <label for="playersub_season" class="input-group-text">{{#i18n}}label.season{{/i18n}}</label>
    <select id="playersub_season" name="seasonId" class="form-select w-auto" onchange="this.form.submit()">
      {{#seasons}}
        {{#selected}}
          <option value="{{value}}" selected>{{label}}</option>
        {{/selected}}{{^selected}}
          <option value="{{value}}">{{label}}</option>
        {{/selected}}
      {{/seasons}}
    </select>
  </div>
        </form>
      </div>
    </div>

    <div class="admin-table-panel mb-4">
  <h2 class="h5 mb-2">{{#i18n}}heading.pendingSubscriptionsAdmin{{/i18n}}</h2>
  <p class="text-body-secondary mb-3">{{playersSubPendingCountsText}}</p>
        <table class="table table-striped table-sm align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">{{#i18n}}label.licence{{/i18n}}</th>
              <th scope="col">{{#i18n}}label.lastname{{/i18n}}</th>
              <th scope="col">{{#i18n}}label.firstname{{/i18n}}</th>
              <th scope="col">{{#i18n}}label.creationUser{{/i18n}}</th>
              <th scope="col">{{#i18n}}label.eventId{{/i18n}}</th>
              <th scope="col">{{#i18n}}label.event{{/i18n}}</th>
              <th scope="col">{{#i18n}}label.action{{/i18n}}</th>
            </tr>
          </thead>
          <tbody>
            {{#pendingRows}}
              <tr>
                <td>{{licence}}</td>
                <td>{{lastname}}</td>
                <td>{{firstname}}</td>
                <td>{{creationUser}}</td>
                <td>{{eventId}}</td>
                <td><a href="{{contextPath}}/event/{{eventId}}">{{eventName}}</a></td>
                <td>
                  <form method="post" action="{{contextPath}}/playersubscription-admin" class="m-0"
                        onsubmit="return confirm('{{#i18n}}action.confirm{{/i18n}}');">
                    <input type="hidden" name="deletePendingId" value="{{id}}">
                    {{#seasonId}}
                      <input type="hidden" name="seasonId" value="{{seasonId}}">
                    {{/seasonId}}
                    <button type="submit" class="btn btn-sm btn-outline-danger">{{#i18n}}action.remove{{/i18n}}</button>
                  </form>
                </td>
              </tr>
            {{/pendingRows}}{{^pendingRows}}
              <tr>
                <td colspan="7" class="text-center text-body-secondary">{{#i18n}}playersub.noPendingSubscriptions{{/i18n}}</td>
              </tr>
            {{/pendingRows}}
          </tbody>
        </table>
      </div>

    <div class="admin-table-panel mb-4">
  <h2 class="h5 mb-2">{{#i18n}}heading.orphanCustomPlayers{{/i18n}}</h2>
  <p class="text-body-secondary mb-3">{{playersSubOrphanCountsText}}</p>
        <div class="d-flex justify-content-end mb-3">
          <form method="post" action="{{contextPath}}/playersubscription-admin" class="m-0">
            <input type="hidden" name="deleteOrphans" value="true">
            {{#seasonId}}
              <input type="hidden" name="seasonId" value="{{seasonId}}">
            {{/seasonId}}
            {{#hasOrphanCustomPlayers}}
              <button type="submit" class="btn btn-outline-danger">{{#i18n}}action.deleteOrphanCustomPlayers{{/i18n}}</button>
            {{/hasOrphanCustomPlayers}}{{^hasOrphanCustomPlayers}}
              <button type="submit" class="btn btn-outline-danger" disabled>{{#i18n}}action.deleteOrphanCustomPlayers{{/i18n}}</button>
            {{/hasOrphanCustomPlayers}}
          </form>
        </div>
        {{#hasOrphanCustomPlayers}}
          <table class="table table-striped table-sm align-middle mb-0">
            <thead>
              <tr>
                <th scope="col">{{#i18n}}label.customPlayer{{/i18n}}</th>
                <th scope="col">{{#i18n}}label.customPlayerLicence{{/i18n}}</th>
                <th scope="col">{{#i18n}}label.creationUser{{/i18n}}</th>
              </tr>
            </thead>
            <tbody>
              {{#orphanCustomPlayers}}
                <tr>
                  <td>
                    <a href="{{contextPath}}/customplayer/{{id}}">
                      {{firstname}} {{name}}
                    </a>
                  </td>
                  <td>{{licence}}</td>
                  <td>{{creationUser}}</td>
                </tr>
              {{/orphanCustomPlayers}}
            </tbody>
          </table>
        {{/hasOrphanCustomPlayers}}{{^hasOrphanCustomPlayers}}
          <p class="text-body-secondary mb-0">{{#i18n}}playersub.noOrphanCustomPlayers{{/i18n}}</p>
        {{/hasOrphanCustomPlayers}}
      </div>

    <div class="admin-table-panel mb-4">
      <div class="d-flex justify-content-end mb-3">
        <form method="post" action="{{contextPath}}/playersubscription-admin">
          <input type="hidden" name="all" value="true">
          {{#seasonId}}
            <input type="hidden" name="seasonId" value="{{seasonId}}">
          {{/seasonId}}
          {{#hasReplaceable}}
            <button type="submit" class="btn btn-primary">{{#i18n}}action.replaceAllByLicence{{/i18n}}</button>
          {{/hasReplaceable}}{{^hasReplaceable}}
            <button type="submit" class="btn btn-primary" disabled>{{#i18n}}action.replaceAllByLicence{{/i18n}}</button>
          {{/hasReplaceable}}
        </form>
      </div>
      <table class="table table-striped table-sm align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">{{#i18n}}label.subscription{{/i18n}}</th>
            <th scope="col">{{#i18n}}label.event{{/i18n}}</th>
            <th scope="col">{{#i18n}}label.creationUser{{/i18n}}</th>
            <th scope="col">{{#i18n}}label.currentReference{{/i18n}}</th>
            <th scope="col">{{#i18n}}label.customPlayer{{/i18n}}</th>
            <th scope="col">{{#i18n}}label.customPlayerLicence{{/i18n}}</th>
            <th scope="col">{{#i18n}}label.lucenePlayer{{/i18n}}</th>
            <th scope="col">{{#i18n}}label.replacementLicence{{/i18n}}</th>
            <th scope="col">{{#i18n}}label.status{{/i18n}}</th>
            <th scope="col">{{#i18n}}label.action{{/i18n}}</th>
          </tr>
        </thead>
        <tbody>
          {{#rows}}
            <tr>
              <td>{{subscriptionId}}</td>
              <td><a href="{{contextPath}}/event/{{eventId}}">{{eventName}}</a></td>
              <td>{{creationUser}}</td>
              <td>{{currentRef}}</td>
              <td>
                {{#hasCustomPlayerId}}
                  <a href="{{contextPath}}/customplayer/{{customPlayerId}}">{{customPlayerName}}</a>
                {{/hasCustomPlayerId}}{{^hasCustomPlayerId}}
                  {{customPlayerName}}
                {{/hasCustomPlayerId}}
              </td>
              <td>{{customPlayerLicence}}</td>
              <td>{{luceneName}}</td>
              <td>{{replacementNrFfe}}</td>
              <td>
                {{#canReplace}}
                  <span class="badge bg-success">{{#i18n}}playersub.status.ready{{/i18n}}</span>
                {{/canReplace}}{{^canReplace}}
                  <span class="badge bg-secondary">{{#i18n}}{{reasonMessageKey}}{{/i18n}}</span>
                {{/canReplace}}
              </td>
              <td>
                {{#canReplace}}
                  <form method="post" action="{{contextPath}}/playersubscription-admin" class="m-0">
                    <input type="hidden" name="subscriptionId" value="{{subscriptionId}}">
                    {{#seasonId}}
                      <input type="hidden" name="seasonId" value="{{seasonId}}">
                    {{/seasonId}}
                    <button type="submit" class="btn btn-sm btn-outline-primary">{{#i18n}}action.replaceByLicence{{/i18n}}</button>
                  </form>
                {{/canReplace}}
              </td>
            </tr>
          {{/rows}}{{^rows}}
            <tr>
              <td colspan="10" class="text-center text-body-secondary">{{#i18n}}info.noSubscription{{/i18n}}</td>
            </tr>
          {{/rows}}
        </tbody>
      </table>
    </div>
  
    </main>
    {{> platform/footer}}

  </body>
</html>

