{{> platform/head}}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">

<html>

<body class="d-flex flex-column min-vh-100 bg-chess-overlay">
{{> platform/menubar}}
    <main class="container flex-fill mt-3">
    <div class="bg-body p-3 rounded mb-3">
    <div class="row justify-content-center mt-3">
        <form id="editForm" method="post" action="{{contextPath}}/event/{{sub.event.id}}/register/{{sub.id}}/option{{^isNew}}/{{option.id}}{{/isNew}}">
            {{^isNew}}
            <input type="hidden" name="toRemove" id="toRemove" value="false">
            {{/isNew}}

            <div class="mb-3">
                <label class="form-label">{{#i18n}}sub.option.parent{{/i18n}}</label>
                <div class="form-control-plaintext">
                    #{{sub.id}}
                    <a href="{{contextPath}}/event/{{sub.event.id}}/register/{{sub.id}}">{{#i18n}}action.view{{/i18n}}</a>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="description">{{#i18n}}sub.option.description{{/i18n}}</label>
                <input type="text" id="description" name="description"
                       value="{{option.description}}" class="form-control" required maxlength="512">
            </div>

            <div class="mb-3">
                <label class="form-label" for="amountCents">{{#i18n}}sub.amountCents{{/i18n}}</label>
                <input type="number" id="amountCents" name="amountCents"
                       value="{{amountCentsValue}}" class="form-control" min="0" step="1" required>
            </div>

            <div class="mb-3">
                <label class="form-label" for="status">{{#i18n}}event.status{{/i18n}}</label>
                <select id="status" name="status" class="form-select" required>
                    {{#statusIsNOT_PAID}}
                    <option value="NOT_PAID" selected>{{#i18n}}playerStatus.NOT_PAID{{/i18n}}</option>
                    {{/statusIsNOT_PAID}}{{^statusIsNOT_PAID}}
                    <option value="NOT_PAID">{{#i18n}}playerStatus.NOT_PAID{{/i18n}}</option>
                    {{/statusIsNOT_PAID}}
                    {{#statusIsPAID}}
                    <option value="PAID" selected>{{#i18n}}playerStatus.PAID{{/i18n}}</option>
                    {{/statusIsPAID}}{{^statusIsPAID}}
                    <option value="PAID">{{#i18n}}playerStatus.PAID{{/i18n}}</option>
                    {{/statusIsPAID}}
                </select>
            </div>

            {{#hasPaymentLink}}
            <div class="mb-3">
                <a class="btn btn-secondary" href="{{contextPath}}/payment/{{paymentId}}/edit">
                    {{#i18n}}action.goToPayment{{/i18n}}
                </a>
            </div>
            {{/hasPaymentLink}}

            <div class="d-flex justify-content-between">
                {{^isNew}}
                <button type="button"
                        class="btn btn-outline-danger"
                        onclick="removeAndSubmit()">
                    🗑️ {{#i18n}}action.remove{{/i18n}}
                </button>
                {{/isNew}}{{#isNew}}
                <a class="btn  btn-secondary" href="{{contextPath}}/event/{{sub.event.id}}/register/{{sub.id}}">
                    {{#i18n}}action.cancel{{/i18n}}
                </a>
                {{/isNew}}

                <button type="submit" class="btn btn-outline-primary">
                    💾 {{#i18n}}action.save{{/i18n}}
                </button>
            </div>

        </form>

{{^isNew}}
<script>
    function removeAndSubmit() {
        if (confirm('{{#i18n}}sub.option.confirmDelete{{/i18n}}')) {
            document.getElementById('toRemove').value = 'true';
            document.getElementById('editForm').submit();
        }
    }
</script>
{{/isNew}}
    </div></div>
    </main>
{{> platform/footer}}
</body>
</html>
