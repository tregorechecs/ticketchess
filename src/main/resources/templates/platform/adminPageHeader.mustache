<div class="admin-table-panel mb-4">
  {{#icon}}
    <div class="d-flex align-items-start gap-3">
      <i class="bi {{icon}} fs-2 text-primary"></i>
      <div>
        <h1 class="h3 mb-1">{{title}}</h1>
        {{#helpText}}
          <p class="text-body-secondary mb-0">{{helpText}}</p>
        {{/helpText}}
      </div>
    </div>
  {{/icon}}
  {{^icon}}
    <h1 class="mb-2">{{title}}</h1>
    {{#helpText}}
      <p class="text-body-secondary mb-0">{{helpText}}</p>
    {{/helpText}}
  {{/icon}}
</div>
