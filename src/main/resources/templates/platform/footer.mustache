<footer class="bg-light border-top mt-5">
  <div class="container py-4">
    <div class="row align-items-center">

      <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
        <span class="text-muted">
          © 2026 <strong>{{pageConfig.orgName}}</strong>
        </span>
      </div>

      <div class="col-md-6 text-center text-md-end">
        <a href="{{contextPath}}/mentions" class="text-muted text-decoration-none me-3">{{#i18n}}footer.legal{{/i18n}}</a>
        <a href="{{pageConfig.contactUrl}}" class="text-muted text-decoration-none me-3">{{#i18n}}footer.contact{{/i18n}}</a>
        {{#pageConfig.sourceUrl}}
          <a href="{{pageConfig.sourceUrl}}" class="text-muted text-decoration-none me-3" target="_blank" rel="noopener noreferrer">{{#i18n}}footer.source{{/i18n}}</a>
          <a href="https://www.gnu.org/licenses/agpl-3.0.html" class="text-muted text-decoration-none" target="_blank" rel="noopener noreferrer">{{#i18n}}footer.license{{/i18n}}</a>
        {{/pageConfig.sourceUrl}}
      </div>

    </div>
  </div>
</footer>
