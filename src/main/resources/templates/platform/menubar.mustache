<nav class="navbar navbar-expand-md navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="{{contextPath}}/">
            {{#pageConfig.logoUrl}}
            <img src="{{contextPath}}{{pageConfig.logoUrl}}" height="30" class="me-2" alt="">
            {{/pageConfig.logoUrl}}
            {{#user.logged}}
                <span class="d-md-none"><i class="bi bi-person-circle"></i> {{user.username}}</span><span class="d-none d-md-block">{{navbarBrand}}</span>
            {{/user.logged}}
            {{^user.logged}}
                <span>{{navbarBrand}}</span>
            {{/user.logged}}
        </a>
        <button class="navbar-toggler"
            type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
            aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                <li class="nav-item">
                    <a id="events" class="nav-link {{#eventsActive}}active{{/eventsActive}}" aria-current="page" href="{{contextPath}}/event">{{#i18n}}menu.events{{/i18n}}</a>
                </li>
                {{#user.logged}}
                <li class="nav-item">
                    <a id="myevents" class="nav-link {{#myeventsActive}}active{{/myeventsActive}}" href="{{contextPath}}/event/my">{{#i18n}}menu.myevents{{/i18n}}
                        {{#hasEventDebt}}
                            <span class="badge bg-warning text-dark">{{eventDebtFormatted}} {{#i18n}}info.topaid{{/i18n}}</span>
                        {{/hasEventDebt}}
                    </a>
                </li>
                {{#user.canSeeAdminMenu}}
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a id="admin" class="nav-link {{#adminActive}}active{{/adminActive}}" href="{{contextPath}}/admin">
                                {{#i18n}}menu.admin{{/i18n}}
                            </a>
                        </li>
                    </ul>
                {{/user.canSeeAdminMenu}}
                {{/user.logged}}
            </ul>
            {{#user.logged}}
                <ul class="navbar-nav">
                    {{#pageConfig.clubRegisterEnabled}}
                    <li class="nav-item me-2">
                        <a id="registerNav" class="nav-link {{#clubregisterActive}}active{{/clubregisterActive}}" href="{{contextPath}}/club-register">
                            {{#i18n}}action.myMembership{{/i18n}}
                            {{#hasMembershipDebt}}
                                <span class="badge bg-warning text-dark">{{membershipDebtFormatted}} {{#i18n}}info.topaid{{/i18n}}</span>
                            {{/hasMembershipDebt}}
                        </a>
                    </li>
                    {{/pageConfig.clubRegisterEnabled}}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i> {{user.username}}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                            {{#pageConfig.accountUrl}}
                            <li><a id="account" class="dropdown-item" href="{{pageConfig.accountUrl}}">{{#i18n}}menu.account{{/i18n}}</a></li>
                            {{/pageConfig.accountUrl}}
                            <li><a id="logout" class="dropdown-item" href="{{contextPath}}/logout">{{#i18n}}menu.disconnect{{/i18n}}</a></li>
                        </ul>
                    </li>
                </ul>
            {{/user.logged}}
            {{^user.logged}}
                <ul class="navbar-nav d-flex">
                    {{#pageConfig.clubRegisterEnabled}}
                    <li class="nav-item me-2">
                        <a id="registerNav" class="nav-link {{#clubregisterActive}}active{{/clubregisterActive}}" href="{{contextPath}}/club-register">
                            {{#i18n}}action.registerClub{{/i18n}}
                        </a>
                    </li>
                    {{/pageConfig.clubRegisterEnabled}}
                    <li class="nav-item">
                    <a id="googleauth" href="{{state.login}}" class="btn btn-outline-light">{{#i18n}}action.login{{/i18n}}</a>
                    </li>
                </ul>
            {{/user.logged}}
        </div>
    </div>
</nav>

