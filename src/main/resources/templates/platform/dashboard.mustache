{{> platform/head}}
<html>
  <body class="d-flex flex-column min-vh-100 bg-chess-overlay">
    {{> platform/menubar}}
    <main class="container flex-fill mt-3">
      <nav aria-label="breadcrumb" class="admin-breadcrumb mb-3">
        <ol class="breadcrumb bg-body rounded px-3 py-2 mb-0">
          <li class="breadcrumb-item"><a href="{{contextPath}}/">{{#i18n}}breadcrumb.home{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/admin">{{#i18n}}menu.admin{{/i18n}}</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{#i18n}}page.dashboard{{/i18n}}</li>
        </ol>
      </nav>

      <div class="admin-table-panel mb-4">
        <div class="d-flex align-items-start gap-3">
          <i class="bi bi-speedometer2 fs-2 text-primary"></i>
          <div>
            <h1 class="h3 mb-1">{{#i18n}}page.dashboard{{/i18n}}</h1>
            <p class="text-body-secondary mb-0">{{#i18n}}admin.tile.dashboardDesc{{/i18n}}</p>
          </div>
        </div>
      </div>

      <div class="admin-table-panel mb-4">
        <form method="get" action="{{contextPath}}/dashboard" class="d-flex flex-wrap align-items-center gap-2 mb-0">
          <div class="input-group w-auto">
            <label for="dashboard_season" class="input-group-text">{{#i18n}}label.season{{/i18n}}</label>
            <select id="dashboard_season" name="seasonId" class="form-select w-auto">
              {{#seasons}}{{#selected}}
                <option value="{{value}}" selected>{{label}}</option>
              {{/selected}}{{^selected}}
                <option value="{{value}}">{{label}}</option>
              {{/selected}}{{/seasons}}
            </select>
          </div>
          <button type="submit" class="btn btn-secondary">{{#i18n}}action.applyFilters{{/i18n}}</button>
        </form>
      </div>

      <div class="admin-table-panel mb-4">
        <h2 class="h5 mb-1">{{#i18n}}dashboard.subsNoPayment{{/i18n}}</h2>
        <p class="text-body-secondary small mb-3">{{subsWithoutPaymentCountText}}</p>
        <table class="table table-striped align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">{{#i18n}}player.name{{/i18n}}</th>
              <th scope="col">{{#i18n}}player.firstname{{/i18n}}</th>
              <th scope="col">{{#i18n}}sub.nrFFE{{/i18n}}</th>
              <th scope="col">{{#i18n}}sub.creationUser{{/i18n}}</th>
              <th scope="col">{{#i18n}}breadcrumb.events{{/i18n}}</th>
              <th scope="col">{{#i18n}}label.action{{/i18n}}</th>
            </tr>
          </thead>
          <tbody>
            {{#subsWithoutPayment}}<tr>
              <td>{{id}}</td>
              <td>{{#player}}{{name}}{{/player}}</td>
              <td>{{#player}}{{firstname}}{{/player}}</td>
              <td>{{nrFfe}}</td>
              <td>{{creationUser}}</td>
              <td><a href="{{contextPath}}/event/{{event.id}}">{{#event.name}}{{event.name}}{{/event.name}}{{^event.name}}{{event.id}}{{/event.name}}</a></td>
              <td><a class="btn btn-sm btn-outline-primary" href="{{contextPath}}/event/{{event.id}}/register/{{id}}">{{#i18n}}action.edit{{/i18n}}</a></td>
            </tr>{{/subsWithoutPayment}}{{^subsWithoutPayment}}
            <tr><td colspan="7" class="text-center text-muted">{{#i18n}}info.noSubscription{{/i18n}}</td></tr>
            {{/subsWithoutPayment}}
          </tbody>
        </table>
      </div>

      <div class="admin-table-panel mb-4">
        <h2 class="h5 mb-1">{{#i18n}}dashboard.cancelledSubs{{/i18n}}</h2>
        <p class="text-body-secondary small mb-3">{{cancelledSubsCountText}}</p>
        <table class="table table-striped align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">{{#i18n}}player.name{{/i18n}}</th>
              <th scope="col">{{#i18n}}player.firstname{{/i18n}}</th>
              <th scope="col">{{#i18n}}sub.nrFFE{{/i18n}}</th>
              <th scope="col">{{#i18n}}sub.creationUser{{/i18n}}</th>
              <th scope="col">{{#i18n}}breadcrumb.events{{/i18n}}</th>
              <th scope="col">{{#i18n}}label.action{{/i18n}}</th>
            </tr>
          </thead>
          <tbody>
            {{#cancelledSubs}}<tr>
              <td>{{id}}</td>
              <td>{{#player}}{{name}}{{/player}}</td>
              <td>{{#player}}{{firstname}}{{/player}}</td>
              <td>{{nrFfe}}</td>
              <td>{{creationUser}}</td>
              <td><a href="{{contextPath}}/event/{{event.id}}">{{#event.name}}{{event.name}}{{/event.name}}{{^event.name}}{{event.id}}{{/event.name}}</a></td>
              <td><a class="btn btn-sm btn-outline-primary" href="{{contextPath}}/event/{{event.id}}/register/{{id}}">{{#i18n}}action.edit{{/i18n}}</a></td>
            </tr>{{/cancelledSubs}}{{^cancelledSubs}}
            <tr><td colspan="7" class="text-center text-muted">{{#i18n}}info.noSubscription{{/i18n}}</td></tr>
            {{/cancelledSubs}}
          </tbody>
        </table>
      </div>

      <div class="admin-table-panel mb-4">
        <h2 class="h5 mb-1">{{#i18n}}dashboard.unpaidSubs{{/i18n}}</h2>
        <p class="text-body-secondary small mb-3">{{notPaidSubsCountText}}</p>
        <table class="table table-striped align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">{{#i18n}}player.name{{/i18n}}</th>
              <th scope="col">{{#i18n}}player.firstname{{/i18n}}</th>
              <th scope="col">{{#i18n}}sub.nrFFE{{/i18n}}</th>
              <th scope="col">{{#i18n}}sub.creationUser{{/i18n}}</th>
              <th scope="col">{{#i18n}}breadcrumb.events{{/i18n}}</th>
              <th scope="col">{{#i18n}}label.action{{/i18n}}</th>
            </tr>
          </thead>
          <tbody>
            {{#notPaidSubs}}<tr>
              <td>{{id}}</td>
              <td>{{#player}}{{name}}{{/player}}</td>
              <td>{{#player}}{{firstname}}{{/player}}</td>
              <td>{{nrFfe}}</td>
              <td>{{creationUser}}</td>
              <td><a href="{{contextPath}}/event/{{event.id}}">{{#event.name}}{{event.name}}{{/event.name}}{{^event.name}}{{event.id}}{{/event.name}}</a></td>
              <td><a class="btn btn-sm btn-outline-primary" href="{{contextPath}}/event/{{event.id}}/register/{{id}}">{{#i18n}}action.edit{{/i18n}}</a></td>
            </tr>{{/notPaidSubs}}{{^notPaidSubs}}
            <tr><td colspan="7" class="text-center text-muted">{{#i18n}}info.noSubscription{{/i18n}}</td></tr>
            {{/notPaidSubs}}
          </tbody>
        </table>
      </div>
    </main>
    {{> platform/footer}}
  </body>
</html>
