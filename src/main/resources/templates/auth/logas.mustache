{{> platform/head}}
<html>
  <body class="d-flex flex-column min-vh-100 bg-chess-overlay">
    {{> platform/menubar}}
    <main class="container flex-fill mt-3">
      {{> platform/adminBreadcrumb}}
      <div class="admin-table-panel mb-4">
        <div class="d-flex align-items-start gap-3">
          <i class="bi bi-incognito fs-2 text-primary"></i>
          <div>
            <h1 class="h3 mb-1">{{#i18n}}heading.logas{{/i18n}}</h1>
            <p class="text-body-secondary mb-0">{{#i18n}}help.logasDesc{{/i18n}}</p>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-6">
          <div class="admin-table-panel mb-4">
            <form method="get" action="{{contextPath}}/auth-sim/logAs">
              <div class="mb-3">
                <label for="email" class="form-label">{{#i18n}}payment.email{{/i18n}}</label>
                <input type="email" class="form-control" id="email" name="email" required>
              </div>
              <div class="mb-3">
                <label for="name" class="form-label">{{#i18n}}logas.displayName{{/i18n}}</label>
                <input type="text" class="form-control" id="name" name="name" required>
              </div>
              <button type="submit" class="btn btn-primary">{{#i18n}}logas.submit{{/i18n}}</button>
            </form>
          </div>
        </div>
        {{#hasSafeUsers}}
        <div class="col-lg-6">
          <div class="admin-table-panel mb-4">
            <h2 class="h5 mb-2">{{#i18n}}logas.knownUsers{{/i18n}}</h2>
            <div class="list-group list-group-flush" style="max-height: 24rem; overflow-y: auto;">
              {{#safeUsers}}
              <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                 href="{{contextPath}}/auth-sim/logAs?email={{emailEncoded}}&name={{emailEncoded}}">
                {{email}}
                {{#admin}}
                  <span class="badge bg-secondary">{{#i18n}}menu.admin{{/i18n}}</span>
                {{/admin}}
              </a>
              {{/safeUsers}}
            </div>
          </div>
        </div>
        {{/hasSafeUsers}}
      </div>
    </main>
    {{> platform/footer}}
  </body>
</html>
