{{> platform/head}}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<body class="d-flex flex-column min-vh-100 bg-chess-overlay">
{{> platform/menubar}}
  <main class="container flex-fill mt-3">
    <div class="bg-body p-3 rounded mb-3">
      <h2>{{#i18n}}sharlySelect.heading{{/i18n}}</h2>
      <p>{{#i18n}}sharlySelect.description{{/i18n}}</p>
    </div>

    {{#error}}
    <div class="alert alert-danger" role="alert">
      {{#invalidCallbackError}}{{#i18n}}sharlySelect.error.invalidCallback{{/i18n}}{{/invalidCallbackError}}
      {{#notFoundError}}{{#i18n}}sharlySelect.error.notFound{{/i18n}}{{/notFoundError}}
      {{#genericError}}{{error}}{{/genericError}}
    </div>
    {{/error}}

    {{#showSelectionList}}
    <div class="bg-body p-3 rounded mb-3">
      {{#itemsEmpty}}
        <p class="text-body-secondary mb-0">{{#i18n}}sharlySelect.empty{{/i18n}}</p>
      {{/itemsEmpty}}
      {{#hasItems}}
        <div class="list-group">
          {{#items}}
            <form method="post" action="{{contextPath}}/sharly/select" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
              <input type="hidden" name="callback" value="{{callback}}">
              <input type="hidden" name="kind" value="{{kindName}}">
              {{#collectionId}}<input type="hidden" name="collectionId" value="{{collectionId}}">{{/collectionId}}
              {{#eventId}}<input type="hidden" name="eventId" value="{{eventId}}">{{/eventId}}
              <div>
                <div class="fw-semibold">{{name}}</div>
                <div class="small text-body-secondary">
                  {{#collection}}
                    {{#i18n}}sharlySelect.collection{{/i18n}} · {{tournamentCount}} {{#i18n}}sharlySelect.tournaments{{/i18n}}
                  {{/collection}}
                  {{^collection}}
                    {{#i18n}}sharlySelect.event{{/i18n}}
                  {{/collection}}
                  · {{chessEventId}}
                </div>
              </div>
              <button type="submit" class="btn btn-primary btn-sm">{{#i18n}}sharlySelect.import{{/i18n}}</button>
            </form>
          {{/items}}
        </div>
      {{/hasItems}}
    </div>
    {{/showSelectionList}}
  </main>
  {{> platform/footer}}
</body>
</html>
