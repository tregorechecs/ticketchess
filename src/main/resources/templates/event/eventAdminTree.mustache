{{> platform/head}}
<html>
  <body class="d-flex flex-column min-vh-100 bg-chess-overlay">
    {{> platform/menubar}}
    <main class="container flex-fill mt-3">
      <nav aria-label="breadcrumb" class="admin-breadcrumb mb-3">
        <ol class="breadcrumb bg-body rounded px-3 py-2 mb-0">
          <li class="breadcrumb-item"><a href="{{contextPath}}/">{{#i18n}}breadcrumb.home{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/admin">{{#i18n}}menu.admin{{/i18n}}</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{#i18n}}page.adminEvents{{/i18n}}</li>
        </ol>
      </nav>

      <div class="admin-table-panel mb-4">
        <div class="d-flex align-items-start gap-3">
          <i class="bi bi-list-nested fs-2 text-primary"></i>
          <div>
            <h1 class="h3 mb-1">{{#i18n}}heading.adminEvents{{/i18n}}</h1>
            <p class="text-body-secondary mb-0">{{#i18n}}help.adminEvents{{/i18n}}</p>
          </div>
        </div>
      </div>

      <div class="admin-table-panel mb-4">
        <div class="row g-3">
          <div class="col-12 col-md-4">
            <a href="{{contextPath}}/eventgroup/new" class="btn btn-success mb-2"><i class="bi bi-diagram-3 me-1"></i>{{#i18n}}adminEvents.createEventGroup{{/i18n}}</a>
            <p class="text-body-secondary small mb-0">{{#i18n}}adminEvents.createEventGroupHelp{{/i18n}}</p>
          </div>
          <div class="col-12 col-md-4">
            <a href="{{contextPath}}/eventcollection/new" class="btn btn-success mb-2"><i class="bi bi-collection me-1"></i>{{#i18n}}adminEvents.createEventCollection{{/i18n}}</a>
            <p class="text-body-secondary small mb-0">{{#i18n}}adminEvents.createEventCollectionHelp{{/i18n}}</p>
          </div>
          {{#showCreateEvent}}
          <div class="col-12 col-md-4">
            <a href="{{contextPath}}/event/new" class="btn btn-success mb-2"><i class="bi bi-calendar-plus me-1"></i>{{#i18n}}adminEvents.createEvent{{/i18n}}</a>
            <p class="text-body-secondary small mb-0">{{#i18n}}admin.tile.eventNewDesc{{/i18n}}</p>
          </div>
          {{/showCreateEvent}}
        </div>
      </div>

      <div class="admin-table-panel mb-4">
        <form method="get" action="{{contextPath}}/admin/events" class="d-flex flex-wrap align-items-center gap-2 mb-3">
          <div class="input-group w-auto">
            <label for="admin_events_season" class="input-group-text">{{#i18n}}label.season{{/i18n}}</label>
            <select id="admin_events_season" name="seasonId" class="form-select w-auto">
              {{#seasons}}{{#selected}}<option value="{{value}}" selected>{{label}}</option>{{/selected}}{{^selected}}<option value="{{value}}">{{label}}</option>{{/selected}}{{/seasons}}
            </select>
          </div>
          <button type="submit" class="btn btn-secondary">{{#i18n}}action.applyFilters{{/i18n}}</button>
        </form>

        {{#treeGroupsEmpty}}
          <p class="text-body-secondary mb-0">{{#i18n}}adminEvents.empty{{/i18n}}</p>
        {{/treeGroupsEmpty}}
        {{^treeGroupsEmpty}}
          <div class="d-flex justify-content-end mb-3">
            <div class="input-group input-group-sm" style="max-width: 420px;">
              <span class="input-group-text"><i class="bi bi-search"></i></span>
              <input id="admin-events-filter" class="form-control" type="search" placeholder="{{#i18n}}adminEvents.filterPlaceholder{{/i18n}}" aria-label="{{#i18n}}adminEvents.filterPlaceholder{{/i18n}}">
            </div>
          </div>
          <p id="admin-events-filter-no-results" class="text-body-secondary mb-0 d-none">{{#i18n}}adminEvents.filterNoResults{{/i18n}}</p>
          <ul class="list-unstyled mb-0 event-admin-tree" id="admin-events-tree">
            {{#treeGroups}}
            <li class="mb-3 event-admin-tree-group" data-search="{{searchText}}">
              <div class="d-flex align-items-center gap-2 fw-semibold">
                <i class="bi bi-diagram-3 text-primary"></i>
                {{#ungrouped}}<span>{{#i18n}}adminEvents.ungrouped{{/i18n}}</span>{{/ungrouped}}
                {{^ungrouped}}{{> event/eventAdminTreeGroupRow}}{{/ungrouped}}
              </div>
              {{#hasChildren}}
              <ul class="list-unstyled ms-4 mt-2 mb-0">
                {{#collections}}
                <li class="mb-2 event-admin-tree-collection">
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-collection text-secondary"></i>
                    {{> event/eventAdminTreeCollectionRow}}
                  </div>
                  <ul class="list-unstyled ms-4 mt-1 mb-0">
                    {{#events}}
                    <li class="py-1 border-bottom border-light-subtle event-admin-tree-event" data-search="{{searchText}}">
                      {{> event/eventAdminTreeEventRow}}
                    </li>
                    {{/events}}
                  </ul>
                </li>
                {{/collections}}
                {{#events}}
                <li class="py-1 border-bottom border-light-subtle event-admin-tree-event" data-search="{{searchText}}">
                  {{> event/eventAdminTreeEventRow}}
                </li>
                {{/events}}
              </ul>
              {{/hasChildren}}
              {{^hasChildren}}
              <p class="text-body-secondary small ms-4 mb-0 mt-1 event-admin-tree-empty">{{#i18n}}adminEvents.noEvents{{/i18n}}</p>
              {{/hasChildren}}
            </li>
            {{/treeGroups}}
          </ul>
        {{/treeGroupsEmpty}}
      </div>
    </main>
    {{> platform/footer}}
    {{#treeFilterScript}}
    <script type="text/javascript">
      (function () {
        const input = document.getElementById('admin-events-filter');
        const tree = document.getElementById('admin-events-tree');
        const noResults = document.getElementById('admin-events-filter-no-results');
        if (!input || !tree) { return; }
        const eventRows = Array.from(tree.querySelectorAll('.event-admin-tree-event'));
        const collectionRows = Array.from(tree.querySelectorAll('.event-admin-tree-collection'));
        const groupRows = Array.from(tree.querySelectorAll('.event-admin-tree-group'));
        function normalize(value) {
          return (value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        }
        function matchesTerms(text, terms) {
          return terms.length === 0 || terms.every((term) => text.includes(term));
        }
        function applyFilter() {
          const terms = normalize(input.value).split(/\s+/).filter(Boolean);
          let visibleEvents = 0;
          eventRows.forEach((row) => {
            const text = normalize(row.getAttribute('data-search') || row.textContent);
            const match = matchesTerms(text, terms);
            row.classList.toggle('d-none', !match);
            if (match) { visibleEvents++; }
          });
          collectionRows.forEach((row) => {
            const events = row.querySelectorAll('.event-admin-tree-event');
            const hasVisible = Array.from(events).some((event) => !event.classList.contains('d-none'));
            row.classList.toggle('d-none', !hasVisible);
          });
          let visibleGroups = 0;
          groupRows.forEach((row) => {
            const events = row.querySelectorAll('.event-admin-tree-event');
            const hasVisibleEvents = Array.from(events).some((event) => !event.classList.contains('d-none'));
            const groupText = normalize(row.getAttribute('data-search') || row.textContent);
            const show = hasVisibleEvents || (events.length === 0 && matchesTerms(groupText, terms));
            row.classList.toggle('d-none', !show);
            if (show) { visibleGroups++; }
          });
          if (noResults) {
            noResults.classList.toggle('d-none', terms.length === 0 || visibleEvents > 0 || visibleGroups > 0);
            tree.classList.toggle('d-none', terms.length > 0 && visibleEvents === 0 && visibleGroups === 0);
          }
        }
        input.addEventListener('input', applyFilter);
        applyFilter();
      })();
    </script>
    {{/treeFilterScript}}
  </body>
</html>
