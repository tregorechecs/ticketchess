{{> platform/head}}
<html>
  <body class="d-flex flex-column min-vh-100 bg-chess-overlay">
    {{> platform/menubar}}
    <main class="container flex-fill mt-3">
      <nav aria-label="breadcrumb" class="mb-3 mt-3">
        <ol class="breadcrumb bg-body rounded px-3 py-2 mb-0">
          <li class="breadcrumb-item"><a href="{{contextPath}}/">{{#i18n}}breadcrumb.home{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/admin">{{#i18n}}menu.admin{{/i18n}}</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{#i18n}}page.eventCollections{{/i18n}}</li>
        </ol>
      </nav>

      <div class="card mb-3">
        <div class="card-body">
          <h1 class="h4 mb-2">{{#i18n}}heading.eventCollections{{/i18n}}</h1>
          <p class="text-body-secondary mb-0">{{#i18n}}help.eventCollections{{/i18n}}</p>
        </div>
      </div>

      {{#created}}<div class="alert alert-success" role="alert">{{#i18n}}message.saveSuccess{{/i18n}}</div>{{/created}}
      {{#updated}}<div class="alert alert-success" role="alert">{{#i18n}}message.saveSuccess{{/i18n}}</div>{{/updated}}
      {{#removed}}<div class="alert alert-success" role="alert">{{#i18n}}message.removeSuccess{{/i18n}}</div>{{/removed}}
      {{#errorMessageKey}}<div class="alert alert-danger" role="alert">{{#i18n}}{{errorMessageKey}}{{/i18n}}</div>{{/errorMessageKey}}

      <div class="card mb-3">
        <div class="card-body">
          <a href="{{contextPath}}/eventcollection/new" class="btn btn-primary">{{#i18n}}action.createGeneric{{/i18n}}</a>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-body p-0">
          <table class="table table-striped table-hover mb-0 align-middle">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">{{#i18n}}event.name{{/i18n}}</th>
                <th scope="col">{{#i18n}}label.events{{/i18n}}</th>
                <th scope="col">{{#i18n}}eventcollection.maxSubscribe{{/i18n}}</th>
                <th scope="col">{{#i18n}}label.action{{/i18n}}</th>
              </tr>
            </thead>
            <tbody>
              {{#eventCollectionRows}}
              <tr>
                <td>{{id}}</td>
                <td><a href="{{contextPath}}/eventcollection/{{id}}">{{name}}</a></td>
                <td>{{eventCount}}</td>
                <td>
                  {{#hasMaxSubscribe}}{{nbSubscriptions}} / {{maxSubscribe}}{{/hasMaxSubscribe}}
                  {{^hasMaxSubscribe}}-{{/hasMaxSubscribe}}
                </td>
                <td class="d-flex gap-1">
                  <a href="{{contextPath}}/eventcollection/{{id}}" class="btn btn-sm btn-outline-primary">{{#i18n}}action.edit{{/i18n}}</a>
                  <a href="{{contextPath}}/eventcollection/{{id}}/statistics" class="btn btn-sm btn-outline-info">&#128202; {{#i18n}}event.statistics{{/i18n}}</a>
                  <a href="{{contextPath}}/eventcollection/{{id}}/mail" class="btn btn-sm btn-secondary">&#9993; {{#i18n}}mail.send{{/i18n}}</a>
                </td>
              </tr>
              {{/eventCollectionRows}}
              {{#eventCollectionsEmpty}}
              <tr>
                <td colspan="5" class="text-center text-body-secondary p-3">{{#i18n}}eventcollection.empty{{/i18n}}</td>
              </tr>
              {{/eventCollectionsEmpty}}
            </tbody>
          </table>
        </div>
      </div>
    </main>
    {{> platform/footer}}
  </body>
</html>
