
{{> platform/head}}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">

<html>


<body class="d-flex flex-column min-vh-100 bg-chess-overlay">

{{> platform/menubar}}
    <main class="container flex-fill mt-3">
      <nav aria-label="breadcrumb" class="mb-3 mt-3">
        <ol class="breadcrumb bg-body rounded px-3 py-2 mb-0">
          <li class="breadcrumb-item"><a href="{{contextPath}}/">{{#i18n}}breadcrumb.home{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/admin">{{#i18n}}menu.admin{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/eventcollection">{{#i18n}}page.eventCollections{{/i18n}}</a></li>
          <li class="breadcrumb-item active" aria-current="page">&#9993; {{#i18n}}mail.sendToAll{{/i18n}}</li>
        </ol>
      </nav>

      <div class="bg-body p-3 rounded mb-3">
        <h2>{{eventCollection.name}} &mdash; {{#i18n}}mail.sendToAll{{/i18n}}</h2>

        {{#sent}}
          <div class="alert alert-success" role="alert">{{sentMessageText}}</div>
        {{/sent}}

        <form method="post" action="{{contextPath}}/eventcollection/{{eventCollection.id}}/mail" accept-charset="UTF-8">

          <div class="mb-3">
            <label for="subject" class="form-label">{{#i18n}}mail.subject{{/i18n}}</label>
            <input type="text" id="subject" name="subject" class="form-control" required>
          </div>

          <div class="mb-3">
            <label for="body" class="form-label">{{#i18n}}mail.body{{/i18n}}</label>
            <textarea id="body" name="body" class="form-control" rows="15" required></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label">{{#i18n}}mail.preview{{/i18n}}</label>
            <iframe id="mail-preview" class="border rounded w-100" style="min-height:400px;background:#f4f6f8;" frameborder="0"></iframe>
          </div>

          <div class="mb-3">
            <label for="subscriptionStatus" class="form-label">{{#i18n}}mail.subscriptionStatus{{/i18n}}</label>
            <select id="subscriptionStatus" name="subscriptionStatus" class="form-control">
              <option value="" selected>{{#i18n}}mail.subscriptionStatus.all{{/i18n}}</option>
              <option value="NOT_PAID">{{#i18n}}playerStatus.NOT_PAID{{/i18n}}</option>
              <option value="PAID">{{#i18n}}playerStatus.PAID{{/i18n}}</option>
              <option value="CANCELLED">{{#i18n}}playerStatus.CANCELLED{{/i18n}}</option>
            </select>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <label for="minElo" class="form-label">{{#i18n}}mail.minElo{{/i18n}}</label>
              <input type="number" id="minElo" name="minElo" class="form-control" min="0" placeholder="{{#i18n}}mail.elo.noLimit{{/i18n}}">
            </div>
            <div class="col-sm-6">
              <label for="maxElo" class="form-label">{{#i18n}}mail.maxElo{{/i18n}}</label>
              <input type="number" id="maxElo" name="maxElo" class="form-control" min="0" placeholder="{{#i18n}}mail.elo.noLimit{{/i18n}}">
            </div>
          </div>

          <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="sendAsBcc" name="sendAsBcc" value="true">
            <label class="form-check-label" for="sendAsBcc">{{#i18n}}mail.sendAsBcc{{/i18n}}</label>
          </div>

          <div class="d-flex gap-2">
            <a class="btn btn-secondary" href="{{contextPath}}/eventcollection/{{eventCollection.id}}">{{#i18n}}action.cancel{{/i18n}}</a>
            <button type="submit" class="btn btn-primary">&#9993; {{#i18n}}mail.send{{/i18n}}</button>
          </div>
        </form>
      </div>
    </main>
{{> platform/footer}}
<script>
(function () {
  var bodyEl = document.getElementById('body');
  var previewFrame = document.getElementById('mail-preview');
  var sendAsBcc = document.getElementById('sendAsBcc');
  var timer = null;

  function updatePreview() {
    var formData = new FormData();
    formData.append('body', bodyEl.value || '');
    formData.append('bcc', sendAsBcc.checked ? "true" : "false");

    fetch('{{contextPath}}/eventcollection/{{eventCollection.id}}/mail/preview', {
      method: 'POST',
      body: new URLSearchParams(formData)
    })
    .then(function(r) { return r.text(); })
    .then(function(html) {
      var doc = previewFrame.contentDocument || previewFrame.contentWindow.document;
      doc.open();
      doc.write(html);
      doc.close();
    });
  }

  function scheduleUpdate() {
    clearTimeout(timer);
    timer = setTimeout(updatePreview, 400);
  }

  bodyEl.addEventListener('input', scheduleUpdate);
  sendAsBcc.addEventListener('change', updatePreview);
  updatePreview();
})();
</script>
</body>
</html>