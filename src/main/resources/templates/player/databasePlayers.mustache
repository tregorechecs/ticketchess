{{> platform/head}}
<html>
  <body class="d-flex flex-column min-vh-100 bg-chess-overlay">
    {{> platform/menubar}}
    <main class="container flex-fill mt-3">
      <nav aria-label="breadcrumb" class="admin-breadcrumb mb-3">
        <ol class="breadcrumb bg-body rounded px-3 py-2 mb-0">
          <li class="breadcrumb-item"><a href="{{contextPath}}/">{{#i18n}}breadcrumb.home{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/admin">{{#i18n}}menu.admin{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/database">{{#i18n}}page.database{{/i18n}}</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{#i18n}}page.databasePlayers{{/i18n}}</li>
        </ol>
      </nav>

      {{#statusIsadded}}
        <div class="alert alert-success">{{#i18n}}databasePlayers.added{{/i18n}}</div>
      {{/statusIsadded}}
      {{#statusIsdeleted}}
        <div class="alert alert-success">{{#i18n}}databasePlayers.deleted{{/i18n}}</div>
      {{/statusIsdeleted}}
      {{#statusIsmissing}}
        <div class="alert alert-warning">{{#i18n}}databasePlayers.missing{{/i18n}}</div>
      {{/statusIsmissing}}
      {{#statusIsvalidation}}
        <div class="alert alert-warning">{{#i18n}}databasePlayers.validation{{/i18n}}</div>
      {{/statusIsvalidation}}
      {{#statusIserror}}
        <div class="alert alert-danger">{{#i18n}}error.serverError{{/i18n}}</div>
      {{/statusIserror}}

      <div class="admin-table-panel mb-4">
        <div class="d-flex align-items-start gap-3">
          <i class="bi bi-person-plus fs-2 text-primary"></i>
          <div>
            <h1 class="h3 mb-1">{{#i18n}}heading.databasePlayers{{/i18n}}</h1>
            <p class="text-body-secondary mb-0">{{#i18n}}help.databasePlayers{{/i18n}}</p>
          </div>
        </div>
      </div>

      <div class="admin-table-panel mb-4">
        <h2 class="h5 mb-3">{{#i18n}}databasePlayers.formTitle{{/i18n}}</h2>
        <div id="manual-player-prefill-status" class="alert d-none" role="alert"></div>
        <form method="post" action="{{contextPath}}/database/manual-players" class="row g-3">
          <div class="col-md-3">
            <label class="form-label" for="nrffe">{{#i18n}}player.licence{{/i18n}}</label>
            <input class="form-control" id="nrffe" name="nrffe">
          </div>
          <div class="col-md-3">
            <label class="form-label" for="fide">FIDE</label>
            <input class="form-control" id="fide" name="fide">
          </div>
          <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-secondary w-100" type="button" id="prefill-player-btn">{{#i18n}}action.prefillFromId{{/i18n}}</button>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="name">{{#i18n}}player.familyname{{/i18n}}</label>
            <input class="form-control" id="name" name="name" required>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="firstname">{{#i18n}}player.firstname{{/i18n}}</label>
            <input class="form-control" id="firstname" name="firstname">
          </div>

          <div class="col-md-2">
            <label class="form-label" for="birth">{{#i18n}}player.birthdate{{/i18n}}</label>
            <input class="form-control" id="birth" name="birth" placeholder="YYYY-MM-DD">
          </div>
          <div class="col-md-2">
            <label class="form-label" for="category">{{#i18n}}label.category{{/i18n}}</label>
            <input class="form-control" id="category" name="category" placeholder="SenM">
          </div>
          <div class="col-md-2">
            <label class="form-label" for="federation">{{#i18n}}player.federation{{/i18n}}</label>
            <input class="form-control" id="federation" name="federation" placeholder="FRA">
          </div>
          <div class="col-md-2">
            <label class="form-label" for="fideTitre">{{#i18n}}label.fideTitle{{/i18n}}</label>
            <input class="form-control" id="fideTitre" name="fideTitre" placeholder="m,f,g...">
          </div>
          <div class="col-md-4">
            <label class="form-label" for="club">{{#i18n}}player.club{{/i18n}}</label>
            <input class="form-control" id="club" name="club">
          </div>

          <div class="col-md-4">
            <label class="form-label" for="eloStd">Elo standard</label>
            <input class="form-control" id="eloStd" name="eloStd" placeholder="1399F">
          </div>
          <div class="col-md-4">
            <label class="form-label" for="eloRapide">Elo rapide</label>
            <input class="form-control" id="eloRapide" name="eloRapide" placeholder="1399F">
          </div>
          <div class="col-md-4">
            <label class="form-label" for="eloBlitz">Elo blitz</label>
            <input class="form-control" id="eloBlitz" name="eloBlitz" placeholder="1399F">
          </div>

          <div class="col-12">
            <button class="btn btn-primary" type="submit">{{#i18n}}databasePlayers.addButton{{/i18n}}</button>
          </div>
        </form>
      </div>

      <div class="admin-table-panel mb-4">
        <h2 class="h5 mb-1">{{#i18n}}databasePlayers.listTitle{{/i18n}}</h2>
        <p class="text-body-secondary">{{manualPlayerCountText}}</p>
        <pre class="bg-light p-2 rounded small mb-3" style="overflow:auto">{{manualPlayersFile}}</pre>
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-end gap-2 mb-3">
          {{#hasSafePlayers}}
            <div class="input-group input-group-sm" style="max-width: 360px;">
              <span class="input-group-text"><i class="bi bi-search"></i></span>
              <input id="manual-player-filter" class="form-control" type="search" placeholder="{{#i18n}}databasePlayers.filterPlaceholder{{/i18n}}" aria-label="{{#i18n}}databasePlayers.filterPlaceholder{{/i18n}}">
            </div>
          {{/hasSafePlayers}}
        </div>
        {{^hasSafePlayers}}
          <div class="text-body-secondary">{{#i18n}}databasePlayers.empty{{/i18n}}</div>
        {{/hasSafePlayers}}
        {{#hasSafePlayers}}
          <table id="manual-player-table" class="table table-striped table-hover mb-0">
            <thead>
              <tr>
                <th scope="col">{{#i18n}}player.licence{{/i18n}}</th>
                <th scope="col">FIDE</th>
                <th scope="col">{{#i18n}}player.familyname{{/i18n}}</th>
                <th scope="col">{{#i18n}}player.firstname{{/i18n}}</th>
                <th scope="col">{{#i18n}}player.birthdate{{/i18n}}</th>
                <th scope="col">{{#i18n}}player.federation{{/i18n}}</th>
                <th scope="col">{{#i18n}}player.club{{/i18n}}</th>
                <th scope="col">{{#i18n}}label.action{{/i18n}}</th>
              </tr>
            </thead>
            <tbody>
              {{#safePlayers}}
                <tr>
                  <td>{{nrffe}}</td>
                  <td>{{fide}}</td>
                  <td>{{name}}</td>
                  <td>{{firstname}}</td>
                  <td>{{birth}}</td>
                  <td>{{federation}}</td>
                  <td>{{club}}</td>
                  <td>
                    <form method="post" action="{{contextPath}}/database/manual-players/delete" onsubmit="return confirm('{{#i18n}}action.confirm{{/i18n}}');">
                      <input type="hidden" name="key" value="{{key}}">
                      <button type="submit" class="btn btn-sm btn-outline-danger">{{#i18n}}action.remove{{/i18n}}</button>
                    </form>
                  </td>
                </tr>
              {{/safePlayers}}
            </tbody>
          </table>
        {{/hasSafePlayers}}
      </div>
    </main>
    {{> platform/footer}}
    <script type="text/javascript">
      (function () {
        const prefillBtn = document.getElementById('prefill-player-btn');
        const nrffeInput = document.getElementById('nrffe');
        const fideInput = document.getElementById('fide');
        const prefillStatus = document.getElementById('manual-player-prefill-status');

        function setPrefillStatus(message, type) {
          if (!prefillStatus) {
            return;
          }
          prefillStatus.className = 'alert alert-' + type;
          prefillStatus.textContent = message;
          prefillStatus.classList.remove('d-none');
        }

        async function prefillPlayer() {
          if (!prefillBtn || !nrffeInput || !fideInput) {
            return;
          }
          const nrffe = (nrffeInput.value || '').trim();
          const fide = (fideInput.value || '').trim();
          if (!nrffe && !fide) {
            setPrefillStatus('{{#i18n}}databasePlayers.prefillNeedId{{/i18n}}', 'warning');
            return;
          }

          prefillBtn.disabled = true;
          const oldText = prefillBtn.textContent;
          prefillBtn.textContent = '{{#i18n}}databasePlayers.prefillLoading{{/i18n}}';
          try {
            const params = new URLSearchParams();
            if (nrffe) {
              params.set('nrffe', nrffe);
            }
            if (fide) {
              params.set('fide', fide);
            }
            const response = await fetch('{{contextPath}}/database/manual-players/prefill?' + params.toString(), {
              headers: {'Accept': 'application/json'}
            });
            if (!response.ok) {
              throw new Error('NOT_FOUND');
            }
            const player = await response.json();
            const mapping = {
              nrffe: player.nrffe,
              fide: player.fide,
              name: player.name,
              firstname: player.firstname,
              birth: player.birthDate,
              category: player.category,
              federation: player.federation,
              club: player.club,
              eloStd: player.rating,
              eloRapide: player.rapidRating,
              eloBlitz: player.blitzRating,
              fideTitre: player.fideTitre
            };
            Object.entries(mapping).forEach(([id, value]) => {
              const element = document.getElementById(id);
              if (element && value !== null && value !== undefined) {
                element.value = value;
              }
            });
            setPrefillStatus('{{#i18n}}databasePlayers.prefillOk{{/i18n}}', 'success');
          } catch (e) {
            setPrefillStatus('{{#i18n}}databasePlayers.prefillNotFound{{/i18n}}', 'warning');
          } finally {
            prefillBtn.disabled = false;
            prefillBtn.textContent = oldText;
          }
        }

        if (prefillBtn) {
          prefillBtn.addEventListener('click', prefillPlayer);
        }

        const input = document.getElementById('manual-player-filter');
        const table = document.getElementById('manual-player-table');
        if (!input || !table) {
          return;
        }

        const rows = Array.from(table.querySelectorAll('tbody tr'));

        function normalize(value) {
          return (value || '')
              .toLowerCase()
              .normalize('NFD')
              .replace(/[\u0300-\u036f]/g, '');
        }

        function applyFilter() {
          const terms = normalize(input.value).split(/\s+/).filter(Boolean);
          rows.forEach((row) => {
            const text = normalize(row.textContent);
            const match = terms.every((term) => text.includes(term));
            row.classList.toggle('d-none', !match);
          });
        }

        input.addEventListener('input', applyFilter);
      })();
    </script>
  </body>
</html>
