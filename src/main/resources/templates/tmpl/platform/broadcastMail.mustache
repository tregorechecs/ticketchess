<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; background-color: #f4f6f8; padding: 20px; }
    .container { max-width: 600px; margin: auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
    .header { background: #1f2937; color: #ffffff; padding: 20px; text-align: center; }
    .content { padding: 25px; color: #333333; }
    .footer { font-size: 12px; color: #777777; text-align: center; padding: 15px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header" style="background: {{#headerBackgroundColor}}{{headerBackgroundColor}}{{/headerBackgroundColor}}{{^headerBackgroundColor}}#1f2937{{/headerBackgroundColor}}; color: {{#headerTextColor}}{{headerTextColor}}{{/headerTextColor}}{{^headerTextColor}}#ffffff{{/headerTextColor}};">
      <h1>{{#headerIcon}}{{headerIcon}} {{/headerIcon}}{{eventName}}{{#name}} - {{name}}{{/name}}</h1>
    </div>
    <div class="content">
      {{{body}}}
      {{#loginUrl}}
      <p><a class="button" href="{{{loginUrl}}}" style="display: inline-block; background-color: #2563eb; color: #ffffff; padding: 10px 20px; border-radius: 5px; text-decoration: none;">{{#buttonText}}{{buttonText}}{{/buttonText}}{{^buttonText}}Accéder au site{{/buttonText}}</a></p>
      {{/loginUrl}}
    </div>
    <div class="footer">
      <p>{{orgName}}</p>
    </div>
  </div>
</body>
</html>
