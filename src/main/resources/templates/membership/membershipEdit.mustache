{{> platform/head}}
<html>
  <body class="d-flex flex-column min-vh-100 bg-chess-overlay">
    {{> platform/menubar}}
    <main class="container flex-fill mt-3">
      <nav aria-label="breadcrumb" class="admin-breadcrumb mb-3">
        <ol class="breadcrumb bg-body rounded px-3 py-2 mb-0">
          <li class="breadcrumb-item"><a href="{{contextPath}}/">{{#i18n}}breadcrumb.home{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/admin">{{#i18n}}menu.admin{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/membership">{{#i18n}}breadcrumb.memberships{{/i18n}}</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{#i18n}}page.membershipEdit{{/i18n}}</li>
        </ol>
      </nav>

      <div class="admin-table-panel mb-4">
        <div class="d-flex align-items-start gap-3">
          <i class="bi bi-person-vcard fs-2 text-primary"></i>
          <div>
            <h1 class="h3 mb-1">{{#i18n}}page.membershipEdit{{/i18n}}</h1>
          </div>
        </div>
      </div>

      <div class="admin-table-panel mb-4">
        <form method="post" action="{{contextPath}}/membership/{{membership.id}}">
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="membership_user" class="form-label">{{#i18n}}admin.membership.user{{/i18n}}</label>
              <input id="membership_user" type="text" name="user" class="form-control" value="{{membership.user}}" required>
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_nrffe" class="form-label">{{#i18n}}admin.membership.nrFfe{{/i18n}}</label>
              <input id="membership_nrffe" type="text" name="nrFfe" class="form-control" value="{{membership.nrFfe}}">
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_lastname" class="form-label">{{#i18n}}label.lastname{{/i18n}}</label>
              <input id="membership_lastname" type="text" name="lastname" class="form-control" value="{{membership.lastname}}">
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_firstname" class="form-label">{{#i18n}}label.firstname{{/i18n}}</label>
              <input id="membership_firstname" type="text" name="firstname" class="form-control" value="{{membership.firstname}}">
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_birthdate" class="form-label">{{#i18n}}player.birthdate{{/i18n}}</label>
              <input id="membership_birthdate" type="date" name="birthDate" class="form-control" value="{{membership.birthDate}}">
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_amount" class="form-label">{{#i18n}}admin.membership.amountCents{{/i18n}}</label>
              <input id="membership_amount" type="number" name="amountCents" class="form-control" min="0" value="{{membership.amountCents}}" required>
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_status" class="form-label">{{#i18n}}label.status{{/i18n}}</label>
              <select id="membership_status" name="status" class="form-select" required>
                {{#statusOptions}}{{#selected}}
                  <option value="{{value}}" selected>{{label}}</option>
                {{/selected}}{{^selected}}
                  <option value="{{value}}">{{label}}</option>
                {{/selected}}{{/statusOptions}}
              </select>
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_season" class="form-label">{{#i18n}}label.season{{/i18n}}</label>
              <select id="membership_season" name="seasonId" class="form-select" required>
                {{#seasonOptions}}{{#selected}}
                  <option value="{{value}}" selected>{{label}}</option>
                {{/selected}}{{^selected}}
                  <option value="{{value}}">{{label}}</option>
                {{/selected}}{{/seasonOptions}}
              </select>
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_license_type" class="form-label">{{#i18n}}admin.membership.licenseType{{/i18n}}</label>
              <select id="membership_license_type" name="licenseType" class="form-select">
                {{#licenseOptions}}{{#selected}}
                  <option value="{{value}}" selected>{{label}}</option>
                {{/selected}}{{^selected}}
                  <option value="{{value}}">{{label}}</option>
                {{/selected}}{{/licenseOptions}}
              </select>
            </div>
          </div>

          {{#user.canManagePayments}}{{#showPaymentLink}}
            <div class="mt-4">
              <a class="btn btn-secondary" href="{{contextPath}}/payment/{{paymentId}}/edit">{{#i18n}}action.goToPayment{{/i18n}}</a>
            </div>
          {{/showPaymentLink}}{{^showPaymentLink}}{{#showNewPaymentLink}}
            <div class="mt-4">
              <a class="btn btn-success" href="{{contextPath}}/payment/new?membershipId={{membership.id}}">{{#i18n}}action.newPayment{{/i18n}}</a>
            </div>
          {{/showNewPaymentLink}}{{/showPaymentLink}}{{/user.canManagePayments}}

          <div class="mt-4">
            <h5 class="mb-3">{{#i18n}}clubRegister.myMemberships.options{{/i18n}}</h5>
            {{#hasMembershipOptions}}
              <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th scope="col">Type</th>
                    <th scope="col">Valeur</th>
                    <th scope="col">Montant</th>
                    <th scope="col">{{#i18n}}label.action{{/i18n}}</th>
                  </tr>
                </thead>
                <tbody>
                  {{#membershipOptionRows}}<tr>
                    <td>{{optionTypeName}}</td>
                    <td>{{optionValue}}</td>
                    <td>{{amountFormatted}} €</td>
                    <td>
                      <a class="btn btn-sm btn-outline-danger" href="{{contextPath}}/membership/{{membership.id}}/option/{{id}}/remove">{{#i18n}}action.remove{{/i18n}}</a>
                    </td>
                  </tr>{{/membershipOptionRows}}
                </tbody>
              </table>
            {{/hasMembershipOptions}}{{^hasMembershipOptions}}
              <p class="text-muted">Aucune option associée</p>
            {{/hasMembershipOptions}}

            <div class="mt-3">
              <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addOptionModal">{{#i18n}}action.addMembershipOption{{/i18n}}</button>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#sendMailModal">Envoyer mail</button>
            <a class="btn btn-secondary" href="{{contextPath}}/membership">{{#i18n}}action.cancel{{/i18n}}</a>
            <button type="submit" class="btn btn-primary" id="membership-save">{{#i18n}}action.save{{/i18n}}</button>
          </div>
        </form>
      </div>

      <div class="modal fade" id="sendMailModal" tabindex="-1" aria-labelledby="sendMailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="sendMailModalLabel">Aperçu de l'email</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
              <p class="text-muted mb-2">Destinataire : <strong>{{membership.user}}</strong></p>
              <p class="text-muted mb-3">Objet : <strong>Votre préinscription a bien été enregistrée</strong></p>
              <iframe id="membershipMailPreview" title="Aperçu de l'email" class="w-100 border rounded" style="min-height: 420px; background-color: #f4f6f8;" src="{{contextPath}}/membership/{{membership.id}}/mail-preview"></iframe>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
              <form method="post" action="{{contextPath}}/membership/{{membership.id}}/send-mail" class="d-inline">
                <button type="submit" class="btn btn-primary">Envoyer l'email</button>
              </form>
            </div>
          </div>
        </div>
      </div>

      <div class="modal fade" id="addOptionModal" tabindex="-1">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">{{#i18n}}action.addMembershipOption{{/i18n}}</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="{{contextPath}}/membership/{{membership.id}}/option">
              <div class="modal-body">
                <div class="mb-3">
                  <label for="option_select" class="form-label">Sélectionner une option</label>
                  <select id="option_select" name="optionId" class="form-select" required>
                    <option value="">-- Sélectionner --</option>
                    {{#availableOptionChoices}}
                      <option value="{{id}}">{{optionValue}} ({{amountFormatted}} €)</option>
                    {{/availableOptionChoices}}
                  </select>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary">Ajouter</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
    {{> platform/footer}}

    <script>
      (function () {
        var modal = document.getElementById('sendMailModal');
        var frame = document.getElementById('membershipMailPreview');
        if (!modal || !frame) {
          return;
        }
        var previewUrl = frame.getAttribute('src');
        modal.addEventListener('show.bs.modal', function () {
          frame.src = previewUrl + (previewUrl.indexOf('?') >= 0 ? '&' : '?') + 't=' + Date.now();
        });
      })();
    </script>
  </body>
</html>
