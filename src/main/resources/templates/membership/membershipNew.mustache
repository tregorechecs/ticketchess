{{> platform/head}}
<html>
  <body class="d-flex flex-column min-vh-100 bg-chess-overlay">
    {{> platform/menubar}}
    <main class="container flex-fill mt-3">
      <nav aria-label="breadcrumb" class="admin-breadcrumb mb-3">
        <ol class="breadcrumb bg-body rounded px-3 py-2 mb-0">
          <li class="breadcrumb-item"><a href="{{contextPath}}/">{{#i18n}}breadcrumb.home{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/admin">{{#i18n}}menu.admin{{/i18n}}</a></li>
          <li class="breadcrumb-item"><a href="{{contextPath}}/membership">{{#i18n}}breadcrumb.memberships{{/i18n}}</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{#i18n}}page.membershipNew{{/i18n}}</li>
        </ol>
      </nav>

      <div class="admin-table-panel mb-4">
        <div class="d-flex align-items-start gap-3">
          <i class="bi bi-person-vcard fs-2 text-primary"></i>
          <div>
            <h1 class="h3 mb-1">{{#i18n}}page.membershipNew{{/i18n}}</h1>
          </div>
        </div>
      </div>

      <div class="admin-table-panel mb-4">
        <form method="post" action="{{contextPath}}/membership">
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="membership_user" class="form-label">{{#i18n}}admin.membership.user{{/i18n}}</label>
              <input id="membership_user" type="text" name="user" class="form-control" required>
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_nrffe" class="form-label">{{#i18n}}admin.membership.nrFfe{{/i18n}}</label>
              <input id="membership_nrffe" type="text" name="nrFfe" class="form-control" required>
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_lastname" class="form-label">{{#i18n}}label.lastname{{/i18n}}</label>
              <input id="membership_lastname" type="text" name="lastname" class="form-control">
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_firstname" class="form-label">{{#i18n}}label.firstname{{/i18n}}</label>
              <input id="membership_firstname" type="text" name="firstname" class="form-control">
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_birthdate" class="form-label">{{#i18n}}player.birthdate{{/i18n}}</label>
              <input id="membership_birthdate" type="date" name="birthDate" class="form-control">
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_amount" class="form-label">{{#i18n}}admin.membership.amountCents{{/i18n}}</label>
              <input id="membership_amount" type="number" name="amountCents" class="form-control" min="0" required>
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_status" class="form-label">{{#i18n}}label.status{{/i18n}}</label>
              <select id="membership_status" name="status" class="form-select" required>
                {{#statusOptions}}{{#selected}}
                  <option value="{{value}}" selected>{{label}}</option>
                {{/selected}}{{^selected}}
                  <option value="{{value}}">{{label}}</option>
                {{/selected}}{{/statusOptions}}
              </select>
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_season" class="form-label">{{#i18n}}label.season{{/i18n}}</label>
              <select id="membership_season" name="seasonId" class="form-select" required>
                {{#seasonOptions}}{{#selected}}
                  <option value="{{value}}" selected>{{label}}</option>
                {{/selected}}{{^selected}}
                  <option value="{{value}}">{{label}}</option>
                {{/selected}}{{/seasonOptions}}
              </select>
            </div>
            <div class="col-12 col-md-6">
              <label for="membership_license_type" class="form-label">{{#i18n}}admin.membership.licenseType{{/i18n}}</label>
              <select id="membership_license_type" name="licenseType" class="form-select">
                {{#licenseOptions}}{{#selected}}
                  <option value="{{value}}" selected>{{label}}</option>
                {{/selected}}{{^selected}}
                  <option value="{{value}}">{{label}}</option>
                {{/selected}}{{/licenseOptions}}
              </select>
            </div>
          </div>
          <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-secondary" href="{{contextPath}}/membership">{{#i18n}}action.cancel{{/i18n}}</a>
            <button type="submit" class="btn btn-primary">{{#i18n}}action.createGeneric{{/i18n}}</button>
          </div>
        </form>
      </div>
    </main>
    {{> platform/footer}}
  </body>
</html>
