<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         metadata-complete="true"
         version="6.1">
    <display-name>Ticketchess</display-name>
    <description>Chess web application</description>

    <listener>
        <listener-class>com.github.gcolin.platform.ApplicationBootstrapListener</listener-class>
    </listener>
    <listener>
        <listener-class>com.github.gcolin.auth.HttpSessionDestroyedListener</listener-class>
    </listener>
    <listener>
        <listener-class>com.github.gcolin.desk.WebSocketDeployer</listener-class>
    </listener>

    <filter>
        <filter-name>RequestContextFilter</filter-name>
        <filter-class>com.github.gcolin.platform.RequestContextFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RequestContextFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>OrgFeatureFilter</filter-name>
        <filter-class>com.github.gcolin.organisation.OrgFeatureFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>OrgFeatureFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ===================== -->
    <!-- 🔹 Jersey en FILTER -->
    <!-- ===================== -->
    <filter>
        <filter-name>jersey</filter-name>
        <filter-class>com.github.gcolin.desk.JerseyWebSocketAwareFilter</filter-class>

        <init-param>
            <param-name>jakarta.ws.rs.Application</param-name>
            <param-value>com.github.gcolin.platform.TicketChessApplication</param-value>
        </init-param>

        <init-param>
            <param-name>jersey.config.servlet.filter.forwardOn404</param-name>
            <param-value>true</param-value>
        </init-param>

        <init-param>
            <param-name>jersey.config.server.wadl.disableWadl</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>

    <filter-mapping>
        <filter-name>jersey</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.github.gcolin.platform.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>
